{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": {"type": "string", "minLength": 1},
            "tag": {"type": "string"}
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "siteId": {"type": "string"},
        "pipelineMode": {"enum": ["direct-db", "jetstream"]},
        "existingSecret": {"type": "string"},
        "nats": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "existingSecret": {"type": "string"}
          }
        },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": {"type": "string"},
            "prefix": {"type": "string"},
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "forcePathStyle": {"type": "boolean"}
          }
        },
        "otlpEndpoint": {"type": "string"},
        "monitoringNamespace": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "instruction-api": {
      "allOf": [
        {"$ref": "#/definitions/app"},
        {"properties": {"service": {"$ref": "#/definitions/service"}}}
      ]
    },
    "dispatcher": {"$ref": "#/definitions/app"},
    "ingest": {
      "allOf": [
        {"$ref": "#/definitions/pipelineApp"},
        {
          "properties": {
            "instances": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/definitions/ingestInstance"}
            }
          }
        }
      ]
    },
    "processor": {"$ref": "#/definitions/pipelineApp"},
    "archiver": {"$ref": "#/definitions/pipelineApp"},
    "portal-publisher": {"$ref": "#/definitions/app"},
    "plantsim": {"$ref": "#/definitions/app"},
    "migrate": {"$ref": "#/definitions/app"}
  },
  "definitions": {
    "app": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "env": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        }
      }
    },
    "pipelineApp": {
      "allOf": [
        {"$ref": "#/definitions/app"},
        {"properties": {"impl": {"enum": ["go", "py"]}}}
      ]
    },
    "ingestInstance": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 40},
        "stream": {"type": "string", "pattern": "^[^.,* >/[:space:]]+$"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "service": {"$ref": "#/definitions/service"}
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort"]},
        "nodePort": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "if": {"required": ["nodePort"]},
      "then": {"required": ["type"], "properties": {"type": {"const": "NodePort"}}}
    }
  }
}
