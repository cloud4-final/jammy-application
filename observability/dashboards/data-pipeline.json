{
  "uid": "data-pipeline",
  "title": "JAMMY Data Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run Id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, run_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "arm",
        "label": "Arm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, arm)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, site)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest events by result",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (service, result) (rate(jammy_ingest_events_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingress wire and decompressed throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (service, kind) (rate(jammy_ingest_bytes_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rejections by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (service, reason) (rate(jammy_ingest_events_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\",result=\"rejected\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JetStream pending",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "jammy_processor_consumer_pending{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}",
          "legendFormat": "{{site}} / {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JetStream lag",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "jammy_processor_lag_seconds{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}",
          "legendFormat": "{{site}} / {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Processor commit p99",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(jammy_processor_commit_duration_seconds_bucket{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Archiver upload throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (service) (rate(jammy_archiver_upload_bytes_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Archiver unacknowledged messages",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "jammy_archiver_unacked_messages{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}",
          "legendFormat": "{{site}} / {{instance}}"
        }
      ]
    }
  ]
}
