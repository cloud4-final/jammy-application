{
  "uid": "control-path",
  "title": "JAMMY Control Path",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run Id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, run_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "arm",
        "label": "Arm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, arm)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, site)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Instruction receipt p99",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_server_request_duration_seconds_bucket{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\",http_route=\"/v1/instructions\",http_request_method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Instruction receipt above 1 second",
      "description": "Share of POST /v1/instructions observations above the 1-second bucket. No traffic leaves the ratio undefined.",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "1 - (sum by (service) (rate(http_server_request_duration_seconds_bucket{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\",http_route=\"/v1/instructions\",http_request_method=\"POST\",le=~\"1([.]0)?\"}[$__rate_interval])) / sum by (service) (rate(http_server_request_duration_seconds_count{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\",http_route=\"/v1/instructions\",http_request_method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Instruction requests by result",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (service, result) (rate(jammy_instruction_requests_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Commands by result",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (service, result) (rate(jammy_dispatcher_commands_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dispatcher leader",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "jammy_dispatcher_is_leader{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}",
          "legendFormat": "{{site}} / {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dispatcher active lease",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "jammy_dispatcher_lease_active{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}",
          "legendFormat": "{{site}} / {{instance}}"
        }
      ]
    }
  ]
}
