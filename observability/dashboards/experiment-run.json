{
  "uid": "experiment-run",
  "title": "JAMMY Experiment Run",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run Id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, run_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "arm",
        "label": "Arm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, arm)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, site)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jammy-metrics"
        },
        "query": "label_values(up, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Accepted ingest events by run and arm",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (run_id, arm, site, service) (rate(jammy_ingest_events_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\",result=\"accepted\"}[$__rate_interval]))",
          "legendFormat": "{{run_id}} {{arm}} {{site}} {{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingest wire throughput by run and arm",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (run_id, arm, site, service) (rate(jammy_ingest_bytes_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\",kind=\"wire\"}[$__rate_interval]))",
          "legendFormat": "{{run_id}} {{arm}} {{site}} {{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processor batch results by run and arm",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (run_id, arm, site, service, result) (rate(jammy_processor_batches_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{run_id}} {{arm}} {{site}} {{service}} {{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Archiver upload throughput by run and arm",
      "datasource": {
        "type": "prometheus",
        "uid": "jammy-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "jammy-metrics"
          },
          "expr": "sum by (run_id, arm, site, service) (rate(jammy_archiver_upload_bytes_total{run_id=~\"${run_id:regex}\",arm=~\"${arm:regex}\",site=~\"${site:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{run_id}} {{arm}} {{site}} {{service}}"
        }
      ]
    }
  ]
}
