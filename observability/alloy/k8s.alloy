discovery.kubernetes "jammy" {
	role = "pod"

	namespaces {
		names = ["jammy"]
	}
}

discovery.relabel "jammy" {
	targets = discovery.kubernetes.jammy.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_annotation_jammy_io_scrape", "__meta_kubernetes_pod_phase"]
		regex         = "true;Running"
		action        = "keep"
	}

	// Pod discovery emits one target per declared port. Keep only admin.
	rule {
		source_labels = ["__meta_kubernetes_pod_container_port_name"]
		regex         = "admin"
		action        = "keep"
	}

	rule {
		source_labels = ["__address__", "__meta_kubernetes_pod_annotation_jammy_io_port"]
		regex         = "(.+):[0-9]+;([0-9]+)"
		replacement   = "${1}:${2}"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_image"]
		regex         = "(?:.*/)?([^/:@]+)(?::[^@]+)?(?:@.+)?"
		replacement   = "$1"
		target_label  = "service"
	}

	// Match the application service label in dashboard filters for both implementations.
	rule {
		source_labels = ["service"]
		regex         = "(ingest|processor|archiver)-(?:go|py)"
		replacement   = "$1"
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_annotation_jammy_io_site"]
		target_label  = "site"
	}
}

prometheus.scrape "pods" {
	targets      = discovery.relabel.jammy.output
	honor_labels = true
	forward_to   = [prometheus.remote_write.victoriametrics.receiver]
}
