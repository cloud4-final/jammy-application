            body = valid_zstd[:-4]
        elif kind == "trailing_bytes":
            body = valid_zstd + b"\x00\x01trailing"
        else:
            body = valid_zstd + valid_zstd
    
        resp = post_batch(
            http_client,
            stack.ingest_a1_url,
            body,
            content_type="application/x-protobuf",
